{
  "name": "WarehouseManager",
  "version": "0.1.1",
  "description": "",
  "license": "ISC",
  "author": "Flare",
  "type": "commonjs",
  "main": "index.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder",
    "pack": "electron-builder --dir"
  },
  "dependencies": {
    "sqlite": "^5.1.1",
    "sqlite3": "^5.1.7"
  },
  "build": {
    "asar": true,
    "appId": "com.reclight.warehousemanagerapp",
    "productName": "LensProWarehouseManager",
    "directories": {
      "output": "dist"
    },
    "files": [
      "index.js",
      "config.js",
      "preload.js",
      "icon.png",
      "renderer/**/*",
      "main/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "LensPro"
    }
  },
  "devDependencies": {
    "electron": "file:_electron-37.5.0.tgz",
    "electron-builder": "^26.8.1"
  }
}
